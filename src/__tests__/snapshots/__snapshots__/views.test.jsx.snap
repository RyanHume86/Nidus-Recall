          </div>
          <div
            class="rapp-stat-lbl"
          >
            Reviews today
          </div>
        </div>
        <div
          class="rapp-stat-box"
        >
          <div
            class="rapp-stat-num"
            data-testid="stat-due-today"
            style="color: rgb(74, 107, 92);"
          >
            0
          </div>
          <div
            class="rapp-stat-lbl"
          >
            Due today
          </div>
        </div>
        <div
          class="rapp-stat-box"
        >
          <div
            class="rapp-stat-num"
            data-testid="stat-streak"
          >
            0
          </div>
          <div
            class="rapp-stat-lbl"
          >
            Day streak
          </div>
        </div>
      </div>
      <div
        class="rapp-card rapp-mb20"
      >
        <div
          class="rapp-sec-title"
        >
          Deck health
        </div>
        <p
          style="font-size: 13px; color: rgb(58, 82, 70); line-height: 1.75;"
        />
      </div>
      <div
        class="rapp-card rapp-mb20"
      >
        <div
          class="rapp-sec-title"
        >
          Recall accuracy
        </div>
        <p
          style="font-size: 13px; color: rgb(74, 107, 92); margin-bottom: 12px;"
        >
          Your recall accuracy appears here after 10 qualifying reviews — keep going.
        </p>
      </div>
    </div>
    <div
      data-testid="empty-state"
      style="text-align: center; padding: 48px 24px; display: flex; flex-direction: column; align-items: center; gap: 8px;"
    >
      <span
        style="font-size: 36px; line-height: 1;"
      >
        📊
      </span>
      <p
        style="font-size: 14px; font-weight: 600; color: rgb(28, 40, 32); margin: 8px 0px 0px;"
      >
        No sessions yet
      </p>
      <p
        style="font-size: 13px; color: rgb(74, 107, 92); margin: 0px; line-height: 1.65; max-width: 280px;"
      >
        Complete your first study session to see progress here.
      </p>
    </div>
  </div>
</div>
`;


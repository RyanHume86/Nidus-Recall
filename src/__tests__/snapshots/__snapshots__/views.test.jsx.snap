                stroke-linejoin="round"
                stroke-width="2"
                style="transform: rotate(0deg); transition: transform 0.18s; flex-shrink: 0;"
                viewBox="0 0 24 24"
                width="13"
              >
                <polyline
                  points="6 9 12 15 18 9"
                />
              </svg>
              <span>
                Connects to
              </span>
              <span
                style="font-size: 11px; color: rgb(74, 107, 92); margin-left: 4px;"
              >
                (optional)
              </span>
            </button>
          </div>
          <div
            class="rapp-mb16"
          >
            <button
              aria-expanded="false"

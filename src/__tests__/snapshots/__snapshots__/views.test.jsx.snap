                class="nid-diff-ins"
              >
                meals
                 
              </span>
            </div>
          </div>
        </div>
      </div>
      <div
        style="display: flex; gap: 8px; flex-wrap: wrap;"
      >
        <button
          style="flex: 1 1 0%; padding: 10px; border-radius: 10px; border: medium; background: rgb(45, 110, 82); color: rgb(255, 255, 255); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;"
        >
          Accept
        </button>
        <button
          style="flex: 1 1 0%; padding: 10px; border-radius: 10px; border: 1px solid rgb(207, 219, 213); background: transparent; color: rgb(58, 82, 70); font-size: 13px; cursor: pointer; font-family: inherit;"

exports[`modal snapshots > AIDiffModal: with clinical warning 1`] = `
<div>
  <div
    style="position: fixed; inset: 0px; background: rgba(28, 40, 32, 0.5); z-index: 300; display: flex; align-items: center; justify-content: center; padding: 24px;"
  >
    <div
      aria-labelledby="ai-diff-title"
      aria-modal="true"
      role="dialog"
      style="background: rgb(235, 240, 237); border-radius: 22px; width: 100%; max-width: 640px; max-height: 90vh; overflow-y: auto; padding: 28px 24px; box-shadow: 0 8px 48px rgba(28,40,32,0.22);"
    >
      <div
        class="rapp-row rapp-sb rapp-mb20"
      >
        <span
          id="ai-diff-title"
          style="font-size: 15px; font-weight: 600; color: rgb(28, 40, 32);"
        >
          Review AI suggestion
        </span>
        <button
          aria-label="Dismiss changes"
          style="background: none; border: medium; cursor: pointer; font-size: 20px; color: rgb(74, 107, 92);"
        >
          ×
        </button>
      </div>
      <div
        class="nid-clinical-warn"
      >
        AI-suggested changes to clinical content can contain subtle factual errors. Verify against a primary source before accepting.
      </div>
      <p
        style="font-size: 12px; color: rgb(74, 107, 92); margin-bottom: 14px; line-height: 1.6;"
      >
        Review the proposed changes. Nothing is saved until you click Accept.
      </p>
      <div
        style="margin-bottom: 14px;"
      >
        <div
          style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: rgb(74, 107, 92); margin-bottom: 8px;"
        >
          Front
        </div>
        <div
          style="display: flex; gap: 12px;"
        >
          <div
            class="nid-diff-col"
          >
            <div
              class="nid-diff-col-label"
            >

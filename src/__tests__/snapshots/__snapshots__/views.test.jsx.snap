                >
                  <polyline
                    points="6 9 12 15 18 9"
                  />
                </svg>
                <span>
                  Note / Context
                </span>
                <span
                  style="font-size: 11px; color: rgb(74, 107, 92); margin-left: 4px;"
                >
                  (optional)
                </span>
              </button>
            </div>
          </div>
          <div
            class="rapp-mb12"
          >
            <div>
              <button
                aria-expanded="false"
                class="nid-note-toggle"
                type="button"
              >
                <svg
                  fill="none"
                  height="13"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  style="transform: rotate(0deg); transition: transform 0.18s; flex-shrink: 0;"
                  viewBox="0 0 24 24"
                  width="13"
                >
                  <polyline
                    points="6 9 12 15 18 9"
                  />
                </svg>
                <span>
                  Memory anchor
                </span>
                <span
                  style="font-size: 11px; color: rgb(74, 107, 92); margin-left: 4px;"
                >
                  (optional)
                </span>
                <span
                  aria-hidden="true"
                  style="margin-left: auto; font-size: 12px; color: rgb(74, 107, 92); cursor: default;"
                  title="Anchoring a personal memory to a card significantly improves long-term recall."
                >
                  ⓘ
                </span>
              </button>
            </div>
          </div>
          <div
            class="rapp-mb12"
          >
            <button
              aria-expanded="false"

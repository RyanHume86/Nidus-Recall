exports[`feature component snapshots > OcclusionCardRenderer: back side (revealed) 1`] = `
<div>
  <div
    style="position: relative; display: inline-block; max-width: 100%;"
  >
    <img
      alt="Occlusion card"
      src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
      style="display: block; max-width: 100%; user-select: none;"
    />
    <svg
      preserveAspectRatio="none"
      style="position: absolute; inset: 0px; width: 100%; height: 100%; pointer-events: none;"
      viewBox="0 0 100 100"
    >
      <g>
        <rect
          fill="rgba(45,110,82,0.35)"
          height="20"
          stroke="#2D6E52"
          stroke-width="0.5"
          width="30"
          x="10"
          y="10"
        />
        <text
          dominant-baseline="middle"
          fill="#fff"
          font-size="3"
          font-weight="600"
          text-anchor="middle"
          x="25"
          y="20"
        >
          Frontal lobe
        </text>
      </g>
    </svg>
  </div>
</div>
`;


              </span>
              <span>
                dose
                 
              </span>
            </div>
          </div>
          <div
            class="nid-diff-col"
          >
            <div
              class="nid-diff-col-label"
            >
              Proposed
            </div>
            <div
              class="nid-diff-proposed"
            >
              <span>
                Drug
                 
              </span>
              <span>
                dose
                 
              </span>
              <span
                class="nid-diff-ins"
              >
                (updated)
                 
              </span>
            </div>
          </div>
        </div>
      </div>
      <div
        style="margin-bottom: 14px;"
      >
        <div
          style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: rgb(74, 107, 92); margin-bottom: 8px;"
        >
          Back
        </div>
        <div
          style="display: flex; gap: 12px;"
        >
          <div
            class="nid-diff-col"
          >
            <div
              class="nid-diff-col-label"
            >
              Original
            </div>
            <div
              class="nid-diff-original"
            >
              <span>
                Metformin
                 
              </span>
              <span>
                500mg
                 
              </span>
              <span>
                BD
                 
              </span>
            </div>
          </div>
          <div
            class="nid-diff-col"
          >
            <div
              class="nid-diff-col-label"
            >

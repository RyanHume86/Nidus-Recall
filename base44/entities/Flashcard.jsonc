{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "clientId":    { "type": "string",  "description": "Stable local ID used by the app" },
    "deckId":      { "type": "string",  "description": "ID of the parent Deck entity" },
    "front":       { "type": "string",  "description": "Question shown on the front" },
    "back":        { "type": "string",  "description": "Answer shown on the back" },
    "contentType": { "type": "string",  "description": "One of: Factual, Mechanism, Clinical Reasoning, Anatomy, Pathology", "default": "Factual" },
    "elaboration": { "type": "string",  "description": "Why is this true — one sentence explanation" },
    "status":      { "type": "string",  "description": "Active | Archived | Parked", "default": "Active" },
    "nextReview":  { "type": "string",  "description": "YYYY-MM-DD date for next scheduled review" },
    "interval":    { "type": "number",  "description": "Days until next review (FSRS)", "default": 1 },
    "reviewCount": { "type": "number",  "description": "Total times reviewed", "default": 0 },
    "stability":   { "type": "number",  "description": "FSRS stability (days of 90% retention)" },
    "difficulty":  { "type": "number",  "description": "FSRS difficulty 1-10" },
    "lapses":      { "type": "number",  "description": "Times rated Again after first review", "default": 0 },
    "lastReview":  { "type": "string",  "description": "YYYY-MM-DD date of last review" }
  },
  "required": ["deckId", "front", "back"]
}

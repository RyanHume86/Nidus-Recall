{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string",
      "description": "App-generated stable ID"
    },
    "deckId": {
      "type": "string",
      "description": "Base44 entity ID of the parent deck"
    },
    "front": {
      "type": "string",
      "description": "The question shown on the front of the card"
    },
    "back": {
      "type": "string",
      "description": "The answer shown on the back of the card"
    },
    "contentType": {
      "type": "string",
      "enum": [
        "Factual",
        "Mechanism",
        "Clinical Reasoning",
        "Anatomy",
        "Pathology"
      ],
      "default": "Factual",
      "description": "Card content category"
    },
    "cardType": {
      "type": "string",
      "enum": ["basic", "cloze", "image_occlusion"],
      "default": "basic",
      "description": "Card rendering type. basic = front/back; cloze = deletion cards; image_occlusion = masked image cards."
    },
    "clozeText": {
      "type": "string",
      "nullable": true,
      "description": "Source text for cloze cards using Anki-compatible {{c1::answer}} or {{c1::answer::hint}} syntax."
    },
    "clozeIndex": {
      "type": "number",
      "nullable": true,
      "description": "Which cloze index this Flashcard represents (1-based). Null for basic cards."
    },
    "imageUrl": {
      "type": "string",
      "nullable": true,
      "description": "URL or Base44 file reference for the source image (image occlusion cards)."
    },
    "occlusionRegions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" }
        }
      },
      "nullable": true,
      "description": "Rectangular mask regions for image occlusion cards. Coordinates are fractions of image dimensions (0.0 to 1.0)."
    },
    "occlusionRegionId": {
      "type": "string",
      "nullable": true,
      "description": "For generated image occlusion cards: which region this card tests. The front shows all other regions unmasked."
    },
    "elaboration": {
      "type": "string",
      "description": "Third-side elaboration shown during review"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Parked",
        "Archived"
      ],
      "default": "Active",
      "description": "Card status"
    },
    "nextReview": {
      "type": "string",
      "description": "Deprecated: use CardState. YYYY-MM-DD date of next scheduled review. Retained for backward compatibility during migration."
    },
    "interval": {
      "type": "number",
      "description": "Deprecated: use CardState. Current review interval in days.",
      "default": 1
    },
    "reviewCount": {
      "type": "number",
      "description": "Deprecated: use CardState. Total number of reviews.",
      "default": 0
    },
    "stability": {
      "type": "number",
      "description": "Deprecated: use CardState. FSRS stability parameter."
    },
    "difficulty": {
      "type": "number",
      "description": "Deprecated: use CardState. FSRS difficulty parameter."
    },
    "lapses": {
      "type": "number",
      "description": "Deprecated: use CardState. Number of times rated Again.",
      "default": 0
    },
    "lastReview": {
      "type": "string",
      "description": "Deprecated: use CardState. YYYY-MM-DD date of last review."
    },
    "anchor": {
      "type": "string",
      "description": "Personal memory anchor: a case, moment, or story connecting this card to existing knowledge.",
      "maxLength": 400
    },
    "stakes_flag": {
      "type": "boolean",
      "default": false,
      "description": "Clinically critical card: prioritised in session queue."
    },
    "connects_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "description": "clientId values of related cards in the same deck."
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 5,
      "description": "User-defined topic tags for card organisation."
    },
    "ratingHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "rating": {
            "type": "string",
            "enum": [
              "again",
              "hard",
              "good",
              "easy"
            ]
          }
        }
      },
      "maxItems": 50,
      "description": "Deprecated: use CardState. Per-card rating event log for calibration scoring."
    },
    "source": {
      "type": "string",
      "description": "Source reference: article, chapter, guideline, or lecture.",
      "maxLength": 200
    },
    "prerequisite_card_id": {
      "type": "string",
      "description": "clientId of a prerequisite card that must reach stability >= 7 before this card enters the review queue."
    }
  },
  "required": [
    "front",
    "back"
  ]
}

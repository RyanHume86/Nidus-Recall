{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string",
      "description": "App-generated stable ID"
    },
    "deckId": {
      "type": "string",
      "description": "Base44 entity ID of the parent deck"
    },
    "front": {
      "type": "string",
      "maxLength": 1500,
      "description": "The question shown on the front of the card"
    },
    "back": {
      "type": "string",
      "maxLength": 3000,
      "description": "The answer shown on the back of the card"
    },
    "contentType": {
      "type": "string",
      "enum": [
        "Factual",
        "Mechanism",
        "Clinical Reasoning",
        "Anatomy",
        "Pathology"
      ],
      "default": "Factual",
      "description": "Card content category"
    },
    "elaboration": {
      "type": "string",
      "maxLength": 5000,
      "description": "Third-side elaboration shown during review"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Parked",
        "Archived"
      ],
      "default": "Active",
      "description": "Card status"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 50
      },
      "maxItems": 5,
      "default": [],
      "description": "User-defined tags for cross-deck filtering. Stored as normalised slugs (lowercase, hyphens)."
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "reviewed",
        "outdated"
      ],
      "default": "unreviewed",
      "description": "Clinical accuracy review status for this card."
    },
    "accuracy_date": {
      "type": "string",
      "description": "YYYY-MM-DD date of the last clinical accuracy review."
    },
    "accuracy_reviewer": {
      "type": "string",
      "maxLength": 120,
      "description": "Name or identifier of the person who reviewed this card's clinical accuracy."
    },
    "guideline_version": {
      "type": "string",
      "maxLength": 100,
      "description": "Clinical guideline version this card was reviewed against (e.g. SAMF 2024, UTD 2025)."
    },
    "nextReview": {
      "type": "string",
      "description": "YYYY-MM-DD date of next scheduled review"
    },
    "interval": {
      "type": "number",
      "description": "Current review interval in days",
      "default": 1
    },
    "reviewCount": {
      "type": "number",
      "description": "Total number of reviews",
      "default": 0
    },
    "stability": {
      "type": "number",
      "description": "FSRS stability parameter"
    },
    "difficulty": {
      "type": "number",
      "description": "FSRS difficulty parameter"
    },
    "lapses": {
      "type": "number",
      "description": "Number of times rated Again",
      "default": 0
    },
    "lastReview": {
      "type": "string",
      "description": "YYYY-MM-DD date of last review"
    },
    "anchor": {
      "type": "string",
      "description": "Personal memory anchor \u2014 a case, moment, or story connecting this card to existing knowledge.",
      "maxLength": 600
    },
    "stakes_flag": {
      "type": "boolean",
      "default": false,
      "description": "Clinically critical card \u2014 prioritised in session queue."
    },
    "connects_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "description": "clientId values of related cards in the same deck."
    },
    "ratingHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "rating": {
            "type": "string",
            "enum": [
              "again",
              "hard",
              "good",
              "easy"
            ]
          }
        }
      },
      "maxItems": 50,
      "description": "Per-card rating event log for calibration scoring."
    },
    "source": {
      "type": "string",
      "description": "Source reference \u2014 article, chapter, guideline, or lecture.",
      "maxLength": 200
    },
    "prerequisite_card_id": {
      "type": "string",
      "description": "Base44 entity ID of the prerequisite card (translated from clientId on write; translated back on read). The referenced card must reach stability >= 7 before this card enters the review queue."
    },
    "imageId": {
      "type": "string",
      "description": "Base44 entity ID of the associated Image record (for occlusion cards)."
    }
  },
  "required": [
    "front",
    "back"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "nullable": true,
      "maxLength": 60,
      "description": "User's first name for personalised greetings only. Mirrored to localStorage under nidus.firstName."
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "sleep_bedtime": {
      "type": "string",
      "nullable": true,
      "description": "User's bedtime in HH:MM 24-hour format for sleep-aware scheduling."
    },
    "sleep_window_minutes": {
      "type": "number",
      "default": 90,
      "description": "Minutes before bedtime when sleep review banner activates."
    },
    "sleep_banner_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show sleep review banner when cards are due near bedtime."
    },
    "mature_card_threshold": {
      "type": "number",
      "default": 30,
      "description": "FSRS stability threshold in days above which a card enters mature review mode."
    },
    "mature_mode_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable mature card review mode with modified prompts."
    },
    "intensity_prompts_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show break prompts when session intensity accumulates."
    },
    "intensity_threshold": {
      "type": "number",
      "default": 40,
      "description": "Cumulative intensity score that triggers a break prompt."
    },
    "fatigue_alerts_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show sustainable pace alerts based on session trend data."
    },
    "attention_declaration_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show focus declaration checkbox at session start."
    },
    "first_study_completed": {
      "type": "boolean",
      "default": false,
      "description": "Set to true after the user completes their first ever card review."
    },
    "sleep_prefers_reviews": {
      "type": "boolean",
      "default": true,
      "description": "When true, due reviews are prioritised over new cards in the pre-bedtime window."
    },
    "notion_integration_token": {
      "type": "string",
      "nullable": true,
      "description": "Notion Internal Integration token (sensitive; stored server-side, never in localStorage or JSON exports)."
    },
    "notion_database_id": {
      "type": "string",
      "nullable": true,
      "description": "Notion database ID or URL for card sync."
    }
  }
}

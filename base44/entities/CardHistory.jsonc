{
  "name": "CardHistory",
  "type": "object",
  "description": "Immutable audit log entry created whenever AI modifies a card. Allows viewing and reverting to any prior version.",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "clientId of the Flashcard this history record belongs to.",
      "required": true
    },
    "version": {
      "type": "number",
      "description": "Sequential version number starting at 1. Higher = more recent.",
      "required": true
    },
    "content_snapshot": {
      "type": "object",
      "description": "Full card content at the time of the change: { front, back, elaboration, source, tags }."
    },
    "modified_by": {
      "type": "string",
      "enum": ["user", "ai"],
      "description": "Who made the change. 'ai' means an LLM-assisted edit was applied."
    },
    "modified_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the modification."
    },
    "ai_model_used": {
      "type": "string",
      "nullable": true,
      "description": "Model identifier used for AI edits. Null for user edits."
    }
  },
  "required": ["card_id", "version"]
}
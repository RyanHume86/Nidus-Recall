{
  "name": "UserSchedulerParams",
  "type": "object",
  "properties": {
    "params": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Fitted FSRS parameter array (19 values). Defaults to ts-fsrs defaults if absent."
    },
    "lastFitDate": {
      "type": "string",
      "nullable": true,
      "description": "ISO date of last parameter fit."
    },
    "reviewCountAtFit": {
      "type": "number",
      "default": 0,
      "description": "Number of reviews available when parameters were last fitted."
    },
    "fitVersion": {
      "type": "string",
      "nullable": true,
      "description": "Version of the fitting algorithm used."
    }
  }
}

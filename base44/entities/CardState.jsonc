{
  "name": "CardState",
  "type": "object",
  "properties": {
    "cardClientId": {
      "type": "string",
      "description": "clientId of the associated Flashcard. Indexed for lookup."
    },
    "stability": {
      "type": "number",
      "nullable": true,
      "description": "FSRS stability parameter (S). Days until 90% retention."
    },
    "difficulty": {
      "type": "number",
      "nullable": true,
      "description": "FSRS difficulty parameter (D)."
    },
    "interval": {
      "type": "number",
      "default": 1,
      "description": "Current review interval in days."
    },
    "nextReview": {
      "type": "string",
      "nullable": true,
      "description": "YYYY-MM-DD date of next scheduled review."
    },
    "lastReview": {
      "type": "string",
      "nullable": true,
      "description": "YYYY-MM-DD date of last review."
    },
    "reviewCount": {
      "type": "number",
      "default": 0,
      "description": "Total number of completed reviews."
    },
    "lapses": {
      "type": "number",
      "default": 0,
      "description": "Number of times rated Again."
    },
    "ratingHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "rating": { "type": "string", "enum": ["again", "hard", "good", "easy"] }
        }
      },
      "maxItems": 50,
      "description": "Per-card rating event log for calibration scoring."
    },
    "suspended": {
      "type": "boolean",
      "default": false,
      "description": "If true, card is excluded from all review queues."
    },
    "buriedUntil": {
      "type": "string",
      "nullable": true,
      "description": "YYYY-MM-DD: exclude from queue until this date."
    },
    "migrated": {
      "type": "boolean",
      "default": false,
      "description": "Set to true by the migration script to mark this record as migrated."
    },
    "clozeIndex": {
      "type": "number",
      "nullable": true,
      "description": "For cloze cards: which deletion index this scheduling row represents. Null for basic cards."
    },
    "sourceCardClientId": {
      "type": "string",
      "nullable": true,
      "description": "For generated cards (cloze, image occlusion): clientId of the parent note. Null for basic cards."
    }
  },
  "required": ["cardClientId"]
}

{
  "name": "Deck",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Name of the deck"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the deck topic"
    },
    "color": {
      "type": "string",
      "description": "Accent color for the deck card",
      "default": "#2D6E52"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "True for built-in onboarding/sample decks managed by the seed script."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}